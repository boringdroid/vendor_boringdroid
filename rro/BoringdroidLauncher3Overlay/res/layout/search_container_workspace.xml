<?xml version="1.0" encoding="utf-8"?>
<!--
    RRO override that removes the Google search pill widget from the first home-screen
    page. We still inflate a `QsbContainerView` so Launcher3's existing cast in
    `Workspace.addFirstPagePinnedItem` succeeds, but we drop the fragment child that
    carries the actual search UI and collapse the view to 0dp so the cell layout does
    not reserve space for it.
-->
<com.android.launcher3.qsb.QsbContainerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:visibility="gone"
    android:padding="0dp" />
